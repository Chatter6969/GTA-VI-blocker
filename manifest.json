{
  "manifest_version": 3,
  "name": "GTA VI Warning",
  "version": "1.3",
  "description": "Ostrzega, gdy strona wspomina o GTA VI.",
  "permissions": ["offscreen"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "gta-warning@example.com" }
  }
}
