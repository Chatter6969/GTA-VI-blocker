{
  "manifest_version": 3,
  "name": "GTA VI Warning",
  "version": "1.3",
  "description": "Ostrzega, gdy strona wspomina o GTA VI.",
  "permissions": [
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/*",
        "*://www.google.pl/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://x.com/*",
        "*://twitter.com/*",
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.tiktok.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "*://*.facebook.com/messages/*",
        "*://*.facebook.com/t/*",
        "*://*.instagram.com/direct/*",
        "*://x.com/messages/*",
        "*://twitter.com/messages/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gta-warning@example.com"
    }
  }
}